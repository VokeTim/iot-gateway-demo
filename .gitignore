#######################################################
# iot-gateway-demo 根目录 .gitignore
# 适用项目类型：Java (Maven/Gradle) + Python
#######################################################

# ---------- 通用：操作系统临时文件 ----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 通用：IDE 元数据 ----------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache
bin/

# VS Code
.vscode/
*.code-workspace

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Maven (Java 构建产物)
target/
build/
*.war
*.ear
*.zip
*.tar
*.gz

# Gradle (Java 构建产物)
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# 日志文件
*.log
logs/
spring-boot.log

# Java 编译输出
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Maven Wrapper
.mvn/wrapper/maven-wrapper.jar

# ---------- Java 特定 ----------
HELP.md
.flattened-pom.xml

# ---------- Python 特定 ----------
# 字节码与优化文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包与分发
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
sdist/
wheels/
*.whl

# 虚拟环境
venv/
.venv/
env/
.env/
.ENV/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# 测试与覆盖率
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Django / Flask / FastAPI
*.local
instance/
webapp/
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Jupyter Notebook
.ipynb_checkpoints/
profile_default/
ipython_config.py

# 类型存根
*.pyi

# mypy
.mypy/

# 翻译
*.mo

# celery
celerybeat-schedule
celerybeat.pid

# Sphinx
docs/_build/

# PyBuilder
target/

# Poetry / PDM
poetry.lock
.pdm.toml
.pdm-python
.pdm-build/

# 环境变量
.env
.env.local
.env.*.local

# IDE Python 相关
.idea/inspectionProfiles/
*.swp
*~

# 总结性组合（避免重复）
# Python
__pycache__/
*.py[cod]
*$py.class

# Java
*.class
target/
build/
.gradle/
*.jar
*.war